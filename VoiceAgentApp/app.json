{
  "expo": {
    "name": "AI Voice Agent",
    "slug": "ai-voice-agent",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#020617"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.voiceagent.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "AI Voice Agent needs microphone access to record your voice for speech-to-text transcription and voice conversations.",
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#020617"
      },
      "package": "com.voiceagent.app",
      "permissions": [
        "RECORD_AUDIO",
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "voice-agent-app"
      }
    },
    "plugins": [
      [
        "expo-av",
        {
          "microphonePermission": "AI Voice Agent needs microphone access for voice conversations."
        }
      ]
    ]
  }
}
