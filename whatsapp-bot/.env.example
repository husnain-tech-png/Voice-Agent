# ============================================
# WhatsApp Voice Agent — Environment Variables
# ============================================

# ------ WhatsApp Cloud API (Required) ------
# Get these from: https://developers.facebook.com → Your App → WhatsApp → API Setup
# The "Permanent Access Token" is under System Users in Business Settings.
WHATSAPP_TOKEN=your_whatsapp_permanent_access_token_here

# Your WhatsApp Business Phone Number ID (visible on the API Setup page)
PHONE_NUMBER_ID=your_phone_number_id_here

# A custom secret string YOU create — used to verify the webhook with Meta
# Can be anything, e.g. "my_voice_agent_secret_2024"
VERIFY_TOKEN=your_custom_verify_token_here

# ------ Groq Cloud API (Required) ------
# Get a free key at: https://console.groq.com/keys
# Powers: Whisper STT (ears) + LLM brain (thinking)
GROQ_API_KEY=your_groq_api_key_here

# ------ Optional Overrides ------
# Groq LLM model (default: llama-3.3-70b-versatile)
# Options: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
# GROQ_LLM_MODEL=llama-3.3-70b-versatile

# Groq STT model (default: whisper-large-v3)
# Options: whisper-large-v3, whisper-large-v3-turbo
# GROQ_STT_MODEL=whisper-large-v3

# Edge TTS voice (default: en-US-AriaNeural)
# Options: en-US-GuyNeural, en-US-JennyNeural, en-GB-SoniaNeural, en-US-ChristopherNeural
# Full list: run `edge-tts --list-voices`
# EDGE_TTS_VOICE=en-US-AriaNeural
