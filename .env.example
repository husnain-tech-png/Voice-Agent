# Server Port (default 3000)
PORT=3000

# Groq API Key (Get a free key at: https://console.groq.com/keys)
# Powers: LLM Brain (openai/gpt-oss-120b) and STT Whisper Turbo (whisper-large-v3-turbo)
GROQ_API_KEY=your_groq_api_key_here

# Groq Model (default: openai/gpt-oss-120b, or openai/gpt-oss-20b)
GROQ_MODEL=openai/gpt-oss-120b

# ElevenLabs API Key (Text-to-Speech / Mouth)
# Get a key at: https://elevenlabs.io
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Default Voice ID (Rachel: 21m00Tcm4TlvDq8ikWAM, Adam: pNInz6obpgDQGcFmaJgB)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Deepgram API Key (Optional Alternative STT)
# Get a key at: https://deepgram.com
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# OpenAI API Key (Optional Alternative LLM)
# Get a key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ==============================================
# Stage 4: Twilio Phone Line Connection
# ==============================================
# Twilio Account SID & Auth Token (Get from: https://console.twilio.com)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Twilio Virtual Phone Number (e.g. +1234567890)
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# Public Domain / Tunnel URL for Webhooks (e.g. https://your-domain.ngrok-free.app)
# Twilio uses this URL to send incoming phone calls to your computer
PUBLIC_URL=https://your-domain.ngrok-free.app

# ==============================================
# Telnyx Telephony & TeXML (Alternative to Twilio)
# ==============================================
# Telnyx API Key (Get from: https://portal.telnyx.com/#/app/api-keys)
TELNYX_API_KEY=your_telnyx_api_key_here
# Telnyx Virtual Phone Number (e.g. +14155550199)
TELNYX_PHONE_NUMBER=your_telnyx_phone_number_here
# Telnyx TeXML Application ID
TELNYX_TEXML_APP_ID=your_texml_app_id_here

# ==============================================
# Stage 5: Mobile Call Forwarding & SMS Summaries
# ==============================================
# Your personal cell phone number (where you want to receive call summary SMS)
# This is the number you'll set up carrier call forwarding FROM
# Format: +country_code followed by number (e.g. +923154483615 for Pakistan, +14155551234 for US)
PERSONAL_PHONE_NUMBER=+923154483615
